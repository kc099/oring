<!-- PatchCore WPF MainWindow — O-Ring Anomaly Detection -->
<Window x:Class="OringInspection.PatchCoreMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O-Ring PatchCore Inspection" Height="850" Width="1300"
        Background="#FF1A1A1E" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="VerdictPass" TargetType="Border">
            <Setter Property="Background" Value="#FF1B5E20"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="VerdictReject" TargetType="Border">
            <Setter Property="Background" Value="#FFD32F2F"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Original Image -->
        <Border Grid.Column="0" Background="#FF202026" CornerRadius="8" Margin="0,0,8,0">
            <Grid>
                <TextBlock Text="Original" Foreground="#FF8A8A90" FontSize="13"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,6,0,0"/>
                <Image x:Name="ImageOriginal" Stretch="Uniform" Margin="8,28,8,8"/>
            </Grid>
        </Border>

        <!-- Heatmap Overlay -->
        <Border Grid.Column="1" Background="#FF202026" CornerRadius="8" Margin="8,0,8,0">
            <Grid>
                <TextBlock Text="Anomaly Heatmap" Foreground="#FF8A8A90" FontSize="13"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,6,0,0"/>
                <Image x:Name="ImageHeatmap" Stretch="Uniform" Margin="8,28,8,8"/>
            </Grid>
        </Border>

        <!-- Right Panel -->
        <StackPanel Grid.Column="2">

            <!-- Model Selection -->
            <TextBlock Text="Model:" Foreground="#FFC8C8CD" FontSize="14" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbModel" Height="32" FontSize="14"
                      SelectionChanged="CmbModel_SelectionChanged"/>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Text="Model: not loaded"
                       Foreground="#FFC8C8CD" FontSize="14" Margin="0,10,0,12"/>

            <!-- Load / Analyze Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Image" Width="140" Height="40"
                        Click="LoadImage_Click"
                        Background="#FF388E3C" Foreground="White"
                        FontSize="15" FontWeight="SemiBold"/>
                <Button x:Name="BtnAnalyze" Content="Analyze" Width="140" Height="40"
                        Click="Analyze_Click" Margin="12,0,0,0"
                        Background="#FF2196F3" Foreground="White"
                        FontSize="15" FontWeight="SemiBold" IsEnabled="False"/>
            </StackPanel>

            <!-- Threshold -->
            <TextBlock Text="Threshold:" Foreground="#FFC8C8CD" FontSize="13" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Slider x:Name="SliderThreshold" Minimum="5" Maximum="30"
                        Value="15" Width="220" VerticalAlignment="Center"
                        ValueChanged="SliderThreshold_ValueChanged"/>
                <TextBlock x:Name="TxtThreshold" Text="15.0" Foreground="#FF8CC8FF"
                           FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Heatmap Alpha -->
            <TextBlock Text="Overlay opacity:" Foreground="#FFC8C8CD" FontSize="13" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Slider x:Name="SliderAlpha" Minimum="0" Maximum="1"
                        Value="0.5" Width="220" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAlpha" Text="0.5" Foreground="#FF8CC8FF"
                           FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Verdict Banner -->
            <Border x:Name="VerdictBorder" Height="100" CornerRadius="12"
                    Background="#FF373740" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="VerdictText" Text="AWAITING"
                               Foreground="White" FontSize="44" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Score Display -->
            <TextBlock x:Name="ScoreText" Text=""
                       Foreground="#FFFFC107" FontSize="20" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <!-- Cycle Time -->
            <TextBlock x:Name="CycleTimeText" Text=""
                       Foreground="#FF8CC8FF" FontSize="16" Margin="0,0,0,8"/>

            <!-- Details -->
            <TextBlock x:Name="DetailsText" Text=""
                       Foreground="#FFC8C8CD" FontSize="13"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
