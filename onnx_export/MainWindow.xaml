<!-- Example WPF MainWindow XAML for O-Ring Inspection -->
<Window x:Class="OringInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O-Ring Inspection" Height="800" Width="1200"
        Background="#FF1A1A1E" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="VerdictPass" TargetType="Border">
            <Setter Property="Background" Value="#FF1B5E20"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="VerdictReject" TargetType="Border">
            <Setter Property="Background" Value="#FFD32F2F"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Image Display -->
        <Border Grid.Column="0" Background="#FF202026" CornerRadius="8" Margin="0,0,16,0">
            <Image x:Name="ImageDisplay" Stretch="Uniform" Margin="8"/>
        </Border>

        <!-- Right Panel -->
        <StackPanel Grid.Column="1">

            <!-- Model Status -->
            <TextBlock x:Name="StatusText" Text="Model: loading..."
                       Foreground="#FFC8C8CD" FontSize="14" Margin="0,0,0,12"/>

            <!-- Load / Analyze Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Image" Width="140" Height="40"
                        Click="LoadImage_Click"
                        Background="#FF388E3C" Foreground="White"
                        FontSize="15" FontWeight="SemiBold"/>
                <Button x:Name="BtnAnalyze" Content="Analyze" Width="140" Height="40"
                        Click="Analyze_Click" Margin="12,0,0,0"
                        Background="#FF2196F3" Foreground="White"
                        FontSize="15" FontWeight="SemiBold" IsEnabled="False"/>
            </StackPanel>

            <!-- Verdict Banner -->
            <Border x:Name="VerdictBorder" Height="100" CornerRadius="12"
                    Background="#FF373740" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="VerdictText" Text="AWAITING"
                               Foreground="White" FontSize="44" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Cycle Time -->
            <TextBlock x:Name="CycleTimeText" Text=""
                       Foreground="#FF8CC8FF" FontSize="16" Margin="0,0,0,12"/>

            <!-- Detection Details -->
            <TextBlock x:Name="DetailsText" Text=""
                       Foreground="#FFC8C8CD" FontSize="14"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
